# makepkg work tree and artefacts, at any depth: a build runs inside the
# package's own directory, and *.pkg.tar.zst / *.tar.gz / *.zip below already
# cover what it downloads and produces there
src/
pkg/
dist/
*.pkg.tar.zst
*.pkg.tar.zst.sig

# sources makepkg downloads into the working directory
*.tar.gz
*.zip

# pipeline scratch
/public/
/.gpg-key-id
/.gpg-key.asc
/.gpg-passphrase

private.key